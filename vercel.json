{
  "buildCommand": "",
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "zermatt-lodge-lime.vercel.app"
        }
      ],
      "destination": "https://bookhomes.co.uk/:path*",
      "permanent": true
    },
    {
      "source": "/stays",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/stays/kosher",
      "destination": "/kosher-homes",
      "permanent": true
    },
    {
      "source": "/stays/:slug((?!listing$|booked$|review$)[a-z0-9-]+)",
      "destination": "/:slug",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/create-checkout",
      "destination": "https://kddhkuwnkkjcnbjegsmc.supabase.co/functions/v1/zermatt-create-checkout"
    },
    {
      "source": "/api/availability",
      "destination": "https://kddhkuwnkkjcnbjegsmc.supabase.co/functions/v1/zermatt-availability"
    },
    {
      "source": "/api/signup",
      "destination": "https://kddhkuwnkkjcnbjegsmc.supabase.co/functions/v1/zermatt-signup"
    },
    {
      "source": "/api/booking-status",
      "destination": "https://kddhkuwnkkjcnbjegsmc.supabase.co/functions/v1/zermatt-booking-status"
    },
    {
      "source": "/api/bh/availability",
      "destination": "https://kddhkuwnkkjcnbjegsmc.supabase.co/functions/v1/bookhomes-availability"
    },
    {
      "source": "/api/bh/listings",
      "destination": "https://kddhkuwnkkjcnbjegsmc.supabase.co/functions/v1/bookhomes-listings"
    },
    {
      "source": "/api/bh/create-checkout",
      "destination": "https://kddhkuwnkkjcnbjegsmc.supabase.co/functions/v1/bookhomes-create-checkout"
    },
    {
      "source": "/api/collect",
      "destination": "https://kddhkuwnkkjcnbjegsmc.supabase.co/functions/v1/bookhomes-collect"
    },
    {
      "source": "/ical/zermatt-lodge.ics",
      "destination": "https://kddhkuwnkkjcnbjegsmc.supabase.co/functions/v1/zermatt-ical-export"
    },
    {
      "source": "/ical/:listing(\\d+)/:token([a-f0-9]{20,80}).ics",
      "destination": "https://kddhkuwnkkjcnbjegsmc.supabase.co/functions/v1/bookhomes-ical-export?listing=:listing&token=:token"
    },
    {
      "source": "/:slug([a-z0-9-]+)",
      "destination": "/stays/listing"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/data/availability.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    },
    {
      "source": "/booking-(confirmed|cancelled)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/admin(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/(sitemap.xml|robots.txt|llms.txt)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/host(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/stays/(booked|review|listing)(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/assets/(stay|stays|host|booked|review|stay-page|stay-dynamic|checkout|saved)\\.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    },
    {
      "source": "/assets/bh(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "has": [
        {
          "type": "query",
          "key": "v"
        }
      ],
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/00d622ef355b6708bc52633c7be81118.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    }
  ]
}
