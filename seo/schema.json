      "mainEntity": [
        {
          "@type": "Question",
          "name": "How many people does Zermatt Lodge sleep?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Zermatt Lodge sleeps up to 7 guests. It is an entire 4-bedroom house with 4 beds: a king in the master bedroom (with en-suite), a second king, a queen and a single."
          }
        },
        {
          "@type": "Question",
          "name": "How many bedrooms and bathrooms are there?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "There are 4 bedrooms and 2 bathrooms. The king master bedroom has its own en-suite, and there is a second bathroom for the other three bedrooms."
          }
        },
        {
          "@type": "Question",
          "name": "Is it the entire house or a shared space?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "You get the entire house to yourselves - all four bedrooms, both bathrooms, the kitchen, dining room, games room and the large private back garden. Nothing is shared with other guests."
          }
        },
        {
          "@type": "Question",
          "name": "Where is Zermatt Lodge?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Zermatt Lodge is a 4-bedroom house in Liverpool, Merseyside, about 15 minutes from the city centre by train or car. The full address is sent to confirmed guests."
          }
        },
        {
          "@type": "Question",
          "name": "Is it close to Aintree University Hospital?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Many guests stay while visiting a Liverpool hospital, including Aintree University Hospital. Free parking for 2 cars means you can drive to the hospital, or you can use Merseyrail."
          }
        },
        {
          "@type": "Question",
          "name": "How far is it from The Walton Centre?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The Walton Centre shares the Aintree University Hospital site on Lower Lane. Free parking at the house means you can drive there, or use Merseyrail."
          }
        },
        {
          "@type": "Question",
          "name": "Is there parking?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, there is free parking for 2 cars at the house. That is useful for hospital visits, as parking on the Aintree hospital site is chargeable."
          }
        },
        {
          "@type": "Question",
          "name": "How do I get to Liverpool city centre?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Liverpool city centre is about 15 minutes by train or car. You can tap in and out with a contactless card or phone."
          }
        },
        {
          "@type": "Question",
          "name": "Is it good for the Grand National?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Aintree Racecourse is very close, and Aintree station runs extra trains on race days. The 2027 Grand National Festival runs 8-10 April 2027, so book early as it is the busiest week of the year."
          }
        },
        {
          "@type": "Question",
          "name": "Is it close to Anfield and Everton's stadium?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It isn't walking distance to either ground. Take the train to Sandhills: Everton fans walk from there, and the matchday Soccerbus runs to Anfield."
          }
        },
        {
          "@type": "Question",
          "name": "What time are check-in and check-out?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Check-in is from 3pm and check-out is by 11am."
          }
        },
        {
          "@type": "Question",
          "name": "Is the house suitable for contractors and work crews?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. It sleeps 7 across 4 bedrooms, has free parking for 2 cars, a big kitchen and a dining room."
          }
        },
        {
          "@type": "Question",
          "name": "Is it good for families and groups?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. There is a games room with a pool table, board games, a 55\" Smart TV with Netflix, a big kitchen, a separate dining room and a large private back garden."
          }
        },
        {
          "@type": "Question",
          "name": "What entertainment is there?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The games room has a pool table, there are board games for all ages, and the living area has a 55\" Smart TV with Netflix."
          }
        },
        {
          "@type": "Question",
          "name": "Can we have a party or event?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Parties and events are not allowed at Zermatt Lodge."
          }
        },
        {
          "@type": "Question",
          "name": "Is smoking allowed?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Smoking is not allowed anywhere in the house."
          }
        },
        {
          "@type": "Question",
          "name": "Are pets allowed?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No, pets are not allowed."
          }
        },
        {
          "@type": "Question",
          "name": "What do I need to provide before my stay?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "All guests booking need to provide ID, sign a rental agreement, and either pay a damage deposit or take the damage waiver. We will ask for these after you book."
          }
        },
        {
          "@type": "Question",
          "name": "How do I book?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "You can book directly on this website - choose your dates in the booking section and pay securely by card. Booking direct means you deal with the host, ZALO Stays, from start to finish."
          }
        },
        {
          "@type": "Question",
          "name": "Who runs Zermatt Lodge?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Zermatt Lodge is run by ZALO Stays. Email cs@zugati.co.uk."
          }
        },
        {
          "@type": "Question",
          "name": "Are there shops nearby?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. There are supermarkets a short drive away, and delivery apps cover the area."
          }
        },
        {
          "@type": "Question",
          "name": "How far is Liverpool John Lennon Airport?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Most guests drive or take a taxi; by public transport you can go via the city centre."
          }
        },
        {
          "@type": "Question",
          "name": "Are there parks nearby?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Liverpool has plenty of green space, including Croxteth Hall and Country Park."
          }
        }
      ]
    }
